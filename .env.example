# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=knime
POSTGRES_PASSWORD=knime_dev
POSTGRES_DB=knime_sop
DATABASE_URL=postgresql+asyncpg://knime:knime_dev@postgres:5432/knime_sop

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Anthropic / LLM ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=anthropic/claude-sonnet-5

# ── App ───────────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/knime_uploads
MAX_UPLOAD_MB=50
